{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tazmin Taraz",
  "version": "1.0.0",
  "identifier": "ir.tazminnet.taraz",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "تضمین تراز", "width": 1280, "height": 820, "minWidth": 380, "minHeight": 560, "center": true, "url": "index.html" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tazmin Taraz",
    "shortDescription": "سیستم حسابداری یکپارچه",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
